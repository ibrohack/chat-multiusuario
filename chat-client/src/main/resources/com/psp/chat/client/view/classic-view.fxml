<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.psp.chat.client.view.ClassicViewController">
   <center>
      <ListView fx:id="messageList" />
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <CheckBox fx:id="privateCheckBox" mnemonicParsing="false" text="Privado" />
            <Label text="Para:" />
            <TextField fx:id="recipientField" prefWidth="110.0" promptText="admin" />
            <TextField fx:id="messageField" onAction="#onSend" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#onSend" text="Enviar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
