<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane minHeight="360.0" minWidth="480.0" prefHeight="560.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.psp.chat.client.view.MainController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="connection-bar">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Label text="IP:" />
            <TextField fx:id="ipField" prefWidth="110.0" promptText="127.0.0.1" />
            <Label text="Puerto:" />
            <TextField fx:id="portField" prefWidth="70.0" promptText="5000" />
            <Label text="Usuario:" />
            <TextField fx:id="usernameField" prefWidth="110.0" promptText="Duxon" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="connectButton" mnemonicParsing="false" onAction="#onConnect" text="Conectar" />
            <Button fx:id="disconnectButton" mnemonicParsing="false" onAction="#onDisconnect" text="Desconectar" />
            <Label fx:id="statusLabel" styleClass="status-label" text="No conectado" />
         </children>
      </HBox>
   </top>
   <center>
      <BorderPane fx:id="contentPane" />
   </center>
</BorderPane>
