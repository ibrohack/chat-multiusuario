<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>


<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="360.0" minWidth="480.0" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.psp.chat.client.view.ChatController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="IP:">
               <HBox.margin>
                  <Insets left="20.0" top="14.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="ipField" prefHeight="25.0" prefWidth="70.0" promptText="127.0.0.1">
               <HBox.margin>
                  <Insets left="5.0" top="10.0" />
               </HBox.margin>
            </TextField>
            <Label layoutX="20.0" layoutY="25.0" text="Puerto:">
               <HBox.margin>
                  <Insets left="10.0" top="14.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="portField" layoutX="38.0" layoutY="20.0" prefHeight="25.0" prefWidth="47.0" promptText="5000">
               <HBox.margin>
                  <Insets left="5.0" top="10.0" />
               </HBox.margin>
            </TextField>
            <Label layoutX="118.0" layoutY="22.0" text="Usuario:">
               <HBox.margin>
                  <Insets left="10.0" top="14.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="usernameField" layoutX="156.0" layoutY="20.0" prefHeight="25.0" prefWidth="47.0" promptText="5000">
               <HBox.margin>
                  <Insets left="5.0" top="10.0" />
               </HBox.margin>
            </TextField>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="connectButton" mnemonicParsing="false" text="Conectar">
               <HBox.margin>
                  <Insets left="10.0" top="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="disconnectButton" disable="true" layoutX="325.0" layoutY="20.0" mnemonicParsing="false" text="Desconectar">
               <HBox.margin>
                  <Insets left="10.0" top="10.0" />
               </HBox.margin>
            </Button>
            <Label fx:id="statusLabel" text="No conectado">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <HBox.margin>
                  <Insets left="10.0" right="20.0" top="14.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <CheckBox fx:id="privateCheckBox" mnemonicParsing="false" text="Privado">
               <HBox.margin>
                  <Insets left="20.0" top="10.0" />
               </HBox.margin>
            </CheckBox>
            <Label text="Para:">
               <HBox.margin>
                  <Insets left="10.0" top="10.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="recipientField">
               <HBox.margin>
                  <Insets left="5.0" top="5.0" />
               </HBox.margin>
            </TextField>
            <TextField fx:id="messageField" prefHeight="25.0" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets left="10.0" top="5.0" />
               </HBox.margin>
            </TextField>
            <Button fx:id="sendButton" mnemonicParsing="false" text="Enviar">
               <HBox.margin>
                  <Insets left="10.0" right="20.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </bottom>
   <center>
      <ScrollPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="200.0" />
        </content>
      </ScrollPane>
   </center>
</BorderPane>
